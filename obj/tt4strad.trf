%_flx_fits_obsubv:
<*zeroflux: the flux from a star at zero magnitude *>;
-- SCALE=-2.5D0*DLOG10(CFLUX*( RY(NZON-1)*UR/(10.d0*UPC) )**2);
 SCALE=-2.5D0*DLOG10(CFLUX*(UR/(10.d0*UPC))**2); -- Ry**2 in Flsav
 freqfind=.false.;

If (^freqfind) then; -- only one time
  _define @NPTSX NPTSU @WLX WLU @lband 1 ; @find;
  _define @NPTSX NPTSB @WLX WLB @lband 2 ; @find;
  _define @NPTSX NPTSV @WLX WLV @lband 3 ; @find;
  _define @NPTSX NPTSR @WLX WLR @lband 4 ; @find;
  _define @NPTSX NPTSI @WLX WLI @lband 5 ; @find;
  _define @NPTSX NPTSSU @WLX WLSu @lband 6 ; @find;
  _define @NPTSX NPTSSG @WLX WLSg @lband 7 ; @find;
  _define @NPTSX NPTSSR @WLX WLSr @lband 8 ; @find;
  _define @NPTSX NPTSSI @WLX WLSi @lband 9 ; @find;
  _define @NPTSX NPTSSZ @WLX WLSz @lband 10 ; @find;
  _define @NPTSX NPTSJ @WLX WLJ @lband 11 ; @find;
  _define @NPTSX NPTSH @WLX WLH @lband 12 ; @find;
  _define @NPTSX NPTSK @WLX WLK @lband 13 ; @find;
  _define @NPTSX NPTSAC @WLX WLAc @lband 14 ; @find;
  _define @NPTSX NPTSAO @WLX WLAo @lband 15 ; @find;
  freqfind=.true.;
endif;

_define @NPTSX NPTSU @WLX WLU @FX0 UF0 @TX TU @lband 1 ;@flux; MU=AMAGX;
_define @NPTSX NPTSB @WLX WLB @FX0 BF0 @TX TB @lband 2 ;@flux; MB=AMAGX;
_define @NPTSX NPTSV @WLX WLV @FX0 VF0 @TX TV @lband 3 ;@flux; MV=AMAGX;
_define @NPTSX NPTSR @WLX WLR @FX0 RF0 @TX TR @lband 4 ;@flux; MR=AMAGX;
_define @NPTSX NPTSI @WLX WLI @FX0 IF0 @TX TI @lband 5 ;@flux; MI=AMAGX;
_define @NPTSX NPTSSU @WLX WLSu @FX0 SUF0 @TX TSu @lband 6 ;@flux; MGU=AMAGX;
_define @NPTSX NPTSSG @WLX WLSg @FX0 SGF0 @TX TSg @lband 7 ;@flux; MGG=AMAGX;
_define @NPTSX NPTSSR @WLX WLSr @FX0 SRF0 @TX TSr @lband 8 ;@flux; MGR=AMAGX;
_define @NPTSX NPTSSI @WLX WLSi @FX0 SIF0 @TX TSi @lband 9 ;@flux; MGI=AMAGX;
_define @NPTSX NPTSSZ @WLX WLSz @FX0 SZF0 @TX TSz @lband 10 ;@flux; MGZ=AMAGX;
_define @NPTSX NPTSJ @WLX WLJ @FX0 JF0 @TX TJ @lband 11 ;@flux; MJ2=AMAGX;
_define @NPTSX NPTSH @WLX WLH @FX0 HF0 @TX TH @lband 12 ;@flux; MH2=AMAGX;
_define @NPTSX NPTSK @WLX WLK @FX0 KF0 @TX TK @lband 13 ;@flux; MK2=AMAGX;
_define @NPTSX NPTSAC @WLX WLAc @FX0 ACF0 @TX TAc @lband 14 ;@flux; MAC=AMAGX;
_define @NPTSX NPTSAO @WLX WLAo @FX0 AOF0 @TX TAo @lband 15 ;@flux; MAO=AMAGX;

%_varubv:o
      INTEGER NPTSU, NPTSB, NPTSV, NPTSR, NPTSI;
      INTEGER NPTSSU, NPTSSG, NPTSSR, NPTSSI, NPTSSZ,
                NPTSJ, NPTSH, NPTSK, NPTSAC, NPTSAO;
      logical debug;
--
      PARAMETER(NPTSU=25);
      PARAMETER(NPTSB=21);
      PARAMETER(NPTSV=24);
      PARAMETER(NPTSR=24);
      PARAMETER(NPTSI=23);
      PARAMETER(NPTSMAX=280);  -- maximum number of points

      real*8 Lbolavg,Mbolavg;
      real*8 U0,B0,V0,UF0,BF0,VF0,RF0,IF0;
      real*8 WLU(NPTSU),TU(NPTSU),WLB(NPTSB),TB(NPTSB),WLV(NPTSV),TV(NPTSV),
                WLR(NPTSR),TR(NPTSR),WLI(NPTSI),TI(NPTSI);

--   Extended band set (transmissions from SVO FPS,
--   https://svo2.cab.inta-csic.es/theory/fps/):
--     u-z = SLOAN/SDSS        (AB system)
--     J-K = 2MASS J,H,Ks      (Vega system, corr -0.90/-1.38/-1.85)
--     c,o = Misc/Atlas.cyan,.orange (AB system, energy-detector curves)
--   Photon-counting SVO curves (DetectorType=1) were converted to
--   energy response (T*lambda, renormalised to peak 1) before
--   tabulation; ATLAS curves are already energy response.
      PARAMETER(NPTSSU=47);
      PARAMETER(NPTSSG=89);
      PARAMETER(NPTSSR=75);
      PARAMETER(NPTSSI=89);
      PARAMETER(NPTSSZ=141);
      PARAMETER(NPTSJ=107);
      PARAMETER(NPTSH=58);
      PARAMETER(NPTSK=76);
      PARAMETER(NPTSAC=248);
      PARAMETER(NPTSAO=273);
      real*8 WLSu(NPTSSU),TSu(NPTSSU),SUF0,MGU;
      real*8 WLSg(NPTSSG),TSg(NPTSSG),SGF0,MGG;
      real*8 WLSr(NPTSSR),TSr(NPTSSR),SRF0,MGR;
      real*8 WLSi(NPTSSI),TSi(NPTSSI),SIF0,MGI;
      real*8 WLSz(NPTSSZ),TSz(NPTSSZ),SZF0,MGZ;
      real*8 WLJ(NPTSJ),TJ(NPTSJ),JF0,MJ2;
      real*8 WLH(NPTSH),TH(NPTSH),HF0,MH2;
      real*8 WLK(NPTSK),TK(NPTSK),KF0,MK2;
      real*8 WLAc(NPTSAC),TAc(NPTSAC),ACF0,MAC;
      real*8 WLAo(NPTSAO),TAo(NPTSAO),AOF0,MAO;

      real*8 FHX, FLXAVG, AMAGX, SCALE;
      logical freqfind;
      integer indfreq;
      common /ubvwrk/indfreq(NPTSMAX,15), freqfind;
--      Common/observer/wH(Nfreq),cH(Nfreq),zerfr;
      parameter(NrecMax=10000);
      real*8 sumlum(Mfreq,0:NrecMax),avglum(Mfreq),timeph(0:NrecMax),
             rphsav(0:NrecMax);
   integer init;
   save init;
   data init/0/;

%_dataubv:o
--      the response functions for UBVRI filters was taken from
--      Bessell M.S.,PASP 102(1990)1181--1199;
--      R & I bands are corresponding roughly to the Cousins system

--      DATA freqfind/.false./; -- bad for transportability;

   DATA U0/-0.7263D+00/;
--
      DATA WLU/3000., 3050., 3100., 3150., 3200., 3250., 3300., 3350.,
       3400., 3450., 3500., 3550., 3600., 3650., 3700., 3750.,
       3800., 3850., 3900., 3950., 4000., 4050., 4100., 4150., 4200./;
--
      DATA TU/0.000, 0.016, 0.068, 0.167, 0.287, 0.423, 0.560, 0.673,
       0.772, 0.841, 0.905, 0.943, 0.981, 0.993, 1.000, 0.989, 0.916,
       0.804, 0.625, 0.423, 0.238, 0.114, 0.051, 0.019, 0.000/;
--
      DATA B0/0.1649D+00/;
--
      DATA WLB/3600.,  3700.,  3800.,  3900.,
       4000.,  4100.,  4200.,  4300.,  4400.,
        4500.,  4600., 4700.,  4800.,  4900.,  5000.,  5100.,
         5200.,  5300.,  5400.,  5500., 5600./;
--
      DATA TB/0.000, 0.030, 0.134, 0.567, 0.920, 0.978, 1.000, 0.978,
       0.935, 0.853, 0.740, 0.640, 0.536, 0.424, 0.325, 0.235, 0.150,
       0.095, 0.043, 0.009, 0.000/;
--
      DATA V0/0.0062D+00/;
--
      DATA WLV/4700., 4800.,  4900.,  5000.,  5100.,
        5200.,  5300.,  5400.,  5500.,  5600.,  5700.,  5800.,  5900.,
        6000.,  6100.,  6200.,  6300.,  6400.,
       6500.,  6600.,  6700.,  6800.,  6900.,
        7000./;
--
      DATA TV/0.000, 0.030,  0.163,  0.458,  0.780,
       0.967,  1.000, 0.973, 0.898, 0.792, 0.684, 0.574,
       0.461, 0.359, 0.270, 0.197, 0.135, 0.081, 0.045, 0.025, 0.017,
       0.013, 0.009, 0.000/;

--
      data WLR/5500., 5600., 5700., 5800., 5900., 6000., 6100., 6200., 6300.,
               6400., 6500., 6600., 6700., 6800., 6900., 7000., 7100., 7200.,
               7300., 7400., 7500., 8000., 8500., 9000./;
--
      data TR/0.00,  0.23,  0.74,  0.91,  0.98,  1.00,  0.98,  0.96,  0.93,
              0.90,  0.86,  0.81,  0.78,  0.72,  0.67,  0.61,  0.56,  0.51,
              0.46,  0.40,  0.35,  0.14,  0.03,  0.00/;
--
      data WLI/7000., 7100., 7200., 7300., 7400., 7500., 7600., 7700., 7800.,
               7900., 8000., 8100., 8200., 8300.,
               8400., 8500., 8600., 8700., 8800., 8900., 9000., 9100., 9200./;
--
      data TI/0.000, 0.024, 0.232, 0.555, 0.785, 0.910, 0.965, 0.985, 0.990,
              0.995, 1.000, 1.000, 0.990, 0.980,
              0.950, 0.910, 0.860, 0.750, 0.560, 0.330, 0.150, 0.030, 0.000/;

--  Extended-band transmission curves (SVO FPS; see %_varubv note)

--  u: SVO curve, NPTS=47, DetectorType=1, Vega-AB corr=0.0
      data WLSu/2980, 3005, 3030, 3055, 3080,
        3105, 3130, 3155, 3180, 3205,
        3230, 3255, 3280, 3305, 3330,
        3355, 3380, 3405, 3430, 3455,
        3480, 3505, 3530, 3555, 3580,
        3605, 3630, 3655, 3680, 3705,
        3730, 3755, 3780, 3805, 3830,
        3855, 3880, 3905, 3930, 3955,
