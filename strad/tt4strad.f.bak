      wlstep=stepn
      sumfhx=0.d0
      endif
09768 CONTINUE
      AMAGX=-2.5D+00*DLOG10(FLXAVG)+SIF0+SCALE
      MGI=AMAGX
      FLXAVG=0.d0
      wlstep=(WLSz(2)-WLSz(1))/CCL
      sumfhx=0.d0
      DO09765i=2,NPTSSZ-1
      Lfr=indfreq(i,11)
