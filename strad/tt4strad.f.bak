      FHX=EXP(LOG(ABS(FHobs1))+LOG(ABS(FHobs/FHobs1))*DLOGNU(Lfr)*LOG((C
     *CL/WLSz(i))/freqob(Lfr+1)))
      else
      FHX=ABS(FHobs)
      endif
      FHX=FHX*TSz(i)*(CCL/WLSz(i))**5
      stepn=(WLSz(i+1)-WLSz(i))/CCL
      if(abs(wlstep-stepn)/wlstep<1.d-4.AND.i/=NPTSSZ-1)then
