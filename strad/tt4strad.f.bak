      FHX=ABS(FHobs)
      endif
      FHX=FHX*TSg(i)*(CCL/WLSg(i))**5
      stepn=(WLSg(i+1)-WLSg(i))/CCL
      if(abs(wlstep-stepn)/wlstep<1.d-4.AND.i/=NPTSSG-1)then
      sumfhx=sumfhx+FHX
      else
      FLXAVG=FLXAVG+sumfhx*wlstep+FHX*(wlstep+stepn)/2.d0
      wlstep=stepn
      sumfhx=0.d0
      endif
09774 CONTINUE
      AMAGX=-2.5D+00*DLOG10(FLXAVG)+SGF0+SCALE
      MGG=AMAGX
      FLXAVG=0.d0
      wlstep=(WLSr(2)-WLSr(1))/CCL
      sumfhx=0.d0
      DO09771i=2,NPTSSR-1
      Lfr=indfreq(i,9)
      FHobs=max(Flsave(Lfr,Jsave),1.d-100)
      FHobs1=max(Flsave(Lfr+1,Jsave),1.d-100)
      If(Lfr<NFRUS)Then
      FHX=EXP(LOG(ABS(FHobs1))+LOG(ABS(FHobs/FHobs1))*DLOGNU(Lfr)*LOG((C
     *CL/WLSr(i))/freqob(Lfr+1)))
      else
      FHX=ABS(FHobs)
      endif
      FHX=FHX*TSr(i)*(CCL/WLSr(i))**5
      stepn=(WLSr(i+1)-WLSr(i))/CCL
      if(abs(wlstep-stepn)/wlstep<1.d-4.AND.i/=NPTSSR-1)then
      sumfhx=sumfhx+FHX
      else
      FLXAVG=FLXAVG+sumfhx*wlstep+FHX*(wlstep+stepn)/2.d0
      wlstep=stepn
      sumfhx=0.d0
      endif
09771 CONTINUE
      AMAGX=-2.5D+00*DLOG10(FLXAVG)+SRF0+SCALE
      MGR=AMAGX
      FLXAVG=0.d0
      wlstep=(WLSi(2)-WLSi(1))/CCL
      sumfhx=0.d0
      DO09768i=2,NPTSSI-1
